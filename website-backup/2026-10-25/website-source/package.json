{
  "name": "puzzlepath-brochure-landing",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone Puzzle Path brochure landing page; npm is development-only.",
  "scripts": {
    "build": "python scripts/build.py",
    "test": "python -m unittest discover -s tests && node --test tests/analytics.test.cjs",
    "test:browser": "node tests/browser.cjs",
    "test:adventure": "node tests/adventure.cjs",
    "test:postcards": "node tests/postcards.cjs",
    "serve": "python -m http.server 4173 --bind 127.0.0.1 --directory dist",
    "audit:mobile": "node scripts/lighthouse.cjs mobile",
    "audit:desktop": "node scripts/lighthouse.cjs desktop"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "lighthouse": "12.8.2",
    "playwright": "1.56.1"
  }
}
